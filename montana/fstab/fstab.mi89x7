#

# Boot
/dev/block/bootdevice/by-name/boot /boot emmc defaults defaults

# Cache
/dev/block/bootdevice/by-name/cache /cache ext4 rw,noatime,nosuid,nodev,barrier=1,data=ordered wait,check,formattable

# Firmware
/dev/block/bootdevice/by-name/modem /vendor/firmware_mnt ext4 ro,nosuid,nodev,barrier=0,context=u:object_r:firmware_file:s0 wait

# Metadata
/dev/block/by-name/oem /metadata ext4 nodev,noatime,nosuid,discard,data=journal,commit=1 check,formattable,first_stage_mount,metadata_csum

# Misc
/dev/block/bootdevice/by-name/misc /misc emmc defaults defaults

# Persist
/dev/block/bootdevice/by-name/persist /mnt/vendor/persist ext4 nosuid,nodev,barrier=1,noatime,noauto_da_alloc,no_sehash_xattr wait

# Recovery
/dev/block/bootdevice/by-name/recovery /recovery emmc defaults defaults

# SDcard
#/devices/platform/soc@0/7864900.mmc/mmc_host/mmc* auto auto defaults voldmanaged=sdcard:auto,encryptable=userdata,noemulatedsd

# System
/dev/block/platform/soc/7824900.sdhci/by-name/system /system ext4 ro,barrier=1,discard wait,first_stage_mount

# USB
#/devices/platform/soc@0/78db000.usb/*/usb* auto auto defaults voldmanaged=usb:auto,noemulatedsd

# Userdata
/dev/block/bootdevice/by-name/userdata /data f2fs rw,discard,nosuid,nodev,noatime,nodiratime,nobarrier,inline_xattr,inline_data wait,check,latemount,formattable,fileencryption=ice,quota,encryptable=/dev/block/bootdevice/by-name/metadata,reservedsize=128M

# ZRAM
/dev/block/zram0 none swap defaults zramsize=50%
